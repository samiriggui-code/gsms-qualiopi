# HTTPS automatique (Let's Encrypt) pour le nom de domaine de l'instance.
{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}

	# Front retiré (refonte en cours) : seule l'API est publiée (routes sous /api/v1, voir docs/API.md).
	# Serveur MCP réservé au moteur IA, sur le réseau interne (http://api:8000/api/v1/mcp) : jamais publié.
	respond /api/v1/mcp* 404
	reverse_proxy api:8000
}
