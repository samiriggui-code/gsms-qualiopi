# Moteur IA WeKnora de gsms-qualiopi (fork Global-IT-SS, images gitss-app:local / gitss-docreader:local
# construites depuis global-it-ss-template/backend). Copier en ia/.env et remplir les secrets :
#   openssl rand -hex 16  → SYSTEM_AES_KEY        openssl rand -hex 32 → JWT_SECRET, SYSTEM_SIGNING_KEY
GIN_MODE=release
TZ=Europe/Paris
AUTO_MIGRATE=true
AUTO_RECOVER_DIRTY=true
WEKNORA_LANGUAGE=fr-FR
DOCREADER_ADDR=ia-docreader:50051
DOCREADER_TRANSPORT=grpc
DB_DRIVER=postgres
DB_HOST=ia-postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=weknora
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=weknora
STREAM_MANAGER_TYPE=redis
REDIS_ADDR=ia-redis:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=stream:
STORAGE_TYPE=local
STORAGE_ALLOW_LIST=local
LOCAL_STORAGE_BASE_DIR=/data/files
RETRIEVE_DRIVER=postgres
OLLAMA_OPTIONAL=true
JWT_SECRET=
SYSTEM_AES_KEY=
SYSTEM_SIGNING_KEY=
WEKNORA_SANDBOX_DOCKER_ENABLED=false
LANGFUSE_ENABLED=false
CONCURRENCY_POOL_SIZE=5

# Inscription libre fermée : seuls existent le compte de service (propriétaire de l'espace, côté serveur) et le
# compte navigateur (contributeur), créés par l'API Qualiopi. Première installation : laisser à false le temps de
# lancer « python -m app.cmd.cli ia-preparer », puis remettre à true et « docker compose up -d ia-app ».
DISABLE_REGISTRATION=true
