# Copier en .env à la racine puis remplacer chaque valeur. Ne jamais committer .env.
POSTGRES_PASSWORD=
# 32 caractères minimum, par exemple : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
APP_ENV=production
API_PORT=8000
# Envoi des e-mails (relances). En local : Mailpit (https://mailpit.axllent.org), port 1025, sans identifiants.
# Sur le VPS : serveur SMTP de l'organisme (port 587 + SMTP_STARTTLS=true, ou 465 + SMTP_SSL=true).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_SSL=false
SMTP_FROM=no-reply@exemple.fr
# Adresse publique du front (liens dans les e-mails)
PUBLIC_URL=http://localhost:3000
